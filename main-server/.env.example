# Copy to .env and fill in. .env is never committed.

# PostgreSQL
DB_USER=anime4kzone
DB_PASSWORD=
DB_NAME=anime4kzone
DB_HOST=localhost
DB_PORT=5432

# Redis, the job queue the GPU worker reads from
REDIS_URL=redis://localhost:6379

# Shikimori OAuth application (client_credentials grant).
# Register at https://shikimori.one/oauth/applications
SHIKIMORI_CLIENT_ID=
SHIKIMORI_CLIENT_SECRET=

# Only needed when the client is served from a different origin than the API.
# Behind the bundled nginx config it is same-origin, so leave this unset.
# CLIENT_ORIGIN=http://example.com:8080
