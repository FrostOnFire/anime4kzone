# Copy to .env and fill in. .env is never committed.

# Redis on the main server — the queue this worker pulls jobs from
REDIS_URL=redis://main-server-host:6379

# Main server: where source files are downloaded from and job status is posted
MAIN_SERVER_URL=http://main-server-host:8080

# Real-ESRGAN checkout, if installed somewhere other than ../Real-ESRGAN
# REALESRGAN_DIR=/opt/Real-ESRGAN
